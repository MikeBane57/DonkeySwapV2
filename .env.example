APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Optional override for the initial password used when admins create or import users (see config/admin.php).
# ADMIN_DEFAULT_USER_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Session cookie Secure flag. Unset = auto: true when APP_ENV=production, false when local.
# Override explicitly if needed (e.g. SESSION_SECURE_COOKIE=false behind a local HTTPS proxy).
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Vite (npm run dev): if you open the site by LAN IP (e.g. http://192.168.0.80) instead of localhost,
# set this to the same host so hot reload WebSocket connects. Otherwise you may see ERR_CONNECTION_REFUSED
# on :5173 — fix by (1) running `npm run dev` in the project, and/or (2) setting this to your machine IP.
# VITE_DEV_SERVER_HOST=192.168.0.80
#
# No dev server? Use a production asset build instead: `npm run build` (then only PHP/Herd is required).

# Web push notifications (generate with: php artisan webpush:vapid, or use https://vapidkeys.com/)
# On live, set APP_URL to your exact HTTPS URL (e.g. https://donkeyswapv2.mikebane.com) so notification icons work on Android.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Optional: set to false if Android push fails (helps some FCM/Firefox Android endpoints)
# WEBPUSH_AUTOMATIC_PADDING=true
